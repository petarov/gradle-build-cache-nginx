# ---------------------------------------------------------------------------
# gradle-build-cache-nginx
#
# Instructions:
#
# 1. copy to .env
# 2. chmod 600 (it holds passwords)
# ---------------------------------------------------------------------------

# Host directory holding store/ (bind-mounted as /data, containing cache/ and
# tmp/) and logs/.
GBC_DATA_DIR=/var/lib/gradle-build-cache-nginx

# Interface and port to publish the cache endpoint on.
GBC_BIND=127.0.0.1
GBC_HTTP_PORT=80

# --------------------------------------------------------------- basic auth ----
# Two independent switches, both optional, named after the HTTP verbs they guard
# (nginx authenticates methods, not callers).
#
#   GBC_HTTP_GET_*   empty -> anyone may read the cache
#   GBC_HTTP_PUT_*   empty -> anyone may write to the cache
#
# PUT is a CI-only verb -- developer builds run isPush=false and never send one.
# So the usual setup on an internal network is: set the PUT pair only, give it to
# CI, leave reads open. A laptop then physically cannot write to the cache, no
# matter what its isPush flag says.
#
# Values land in `docker inspect` output; keep this file 0600.
GBC_HTTP_PUT_USER=ci
GBC_HTTP_PUT_PASSWORD=changeme
#GBC_HTTP_GET_USER=dev
#GBC_HTTP_GET_PASSWORD=changeme

# ------------------------------------------------------------------- storage ----
# Largest single entry accepted. These are task outputs (class trees, jars, test
# results), not dependencies -- typically a few MB. Exceeding this yields 413,
# which disables the remote cache for the rest of that build, so keep it well
# above your worst entry. Find your real ceiling once the cache has run a while:
#   find $GBC_DATA_DIR/store/cache -type f -printf '%s\n' | sort -n | tail -5
GBC_MAX_ENTRY_SIZE=512m

# --------------------------------------------------------------- operational ----
# Read by systemd/gbc-evict.sh (not by nginx).
# Defaults assume ~200 GB of disk for the cache; tune to your budget.
GBC_MAX_SIZE_GB=200
GBC_MAX_AGE_DAYS=14
