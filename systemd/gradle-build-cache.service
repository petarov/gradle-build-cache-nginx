# /etc/systemd/system/gradle-build-cache.service
# systemctl daemon-reload && systemctl enable --now gradle-build-cache
[Unit]
Description=Gradle raw HTTP build cache (nginx + dav)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/gradle-build-cache-raw
# `up` in the foreground, so systemd supervises the container rather than a
# detached daemon it cannot see. Compose forwards SIGTERM to nginx as SIGQUIT
# (STOPSIGNAL in the Dockerfile) = graceful drain of in-flight PUTs.
ExecStartPre=/usr/bin/docker compose pull --quiet --ignore-buildable
ExecStart=/usr/bin/docker compose up --build --abort-on-container-exit --no-log-prefix
ExecStop=/usr/bin/docker compose down --timeout 30
Restart=always
RestartSec=5s
TimeoutStopSec=60s

[Install]
WantedBy=multi-user.target
