# /etc/systemd/system/gbc-evict.service
[Unit]
Description=Evict old/excess Gradle build cache entries
After=gradle-build-cache.service

[Service]
Type=oneshot
ExecStart=/opt/gradle-build-cache-raw/systemd/gbc-evict.sh
# The size pass can walk millions of inodes; keep it out of the way of builds.
Nice=10
IOSchedulingClass=idle
